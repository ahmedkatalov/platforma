# Скопируйте в backend/.env.production на сервере и заполните.
# DATABASE_URL и APP_ENV подставляет docker-compose.prod.yml — здесь их не задавать.

PORT=8090

# Адрес, по которому платформа открыта в браузере (нужен для ссылок в письмах).
PUBLIC_BASE_URL=https://ВАШ-ДОМЕН

# Домены, с которых разрешены запросы к API.
CORS_ORIGINS=https://ВАШ-ДОМЕН

# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# EmailJS — те же ключи, что локально.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_FROM_NAME=DevOps Platform
EMAILJS_NOTICE_TEMPLATE_ID=
VERIFICATION_CODE_TTL=15m
