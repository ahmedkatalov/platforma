# --- Сервер ---
PORT=8090
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- База данных (docker compose up -d db) ---
DATABASE_URL=postgres://platforma:platforma@localhost:5433/platforma?sslmode=disable

# --- Безопасность ---
# Сгенерировать новый: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# --- EmailJS (коды подтверждения на почту) ---
# Если не заполнено, коды печатаются в лог сервера — удобно для локальной разработки.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_FROM_NAME=DevOps Platform
VERIFICATION_CODE_TTL=15m

# Отдельный шаблон EmailJS для уведомлений: сертификаты и напоминания о сроках.
# Если пусто — используется EMAILJS_TEMPLATE_ID (тот же, что для кодов).
# Переменные шаблона: {{subject}}, {{message}}, {{link}}, {{to_email}}, {{to_name}}.
EMAILJS_NOTICE_TEMPLATE_ID=

# Как часто проверять сроки прохождения и неактивных студентов.
REMINDER_INTERVAL=6h

# Каталог для картинок, загруженных в уроки.
UPLOAD_DIR=uploads
